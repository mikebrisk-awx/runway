rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All authenticated users can read/write most collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    // Passcode document: only readable by server (Admin SDK bypasses rules)
    // Client reads are blocked for all users including admins
    match /settings/figmaSecret {
      allow read, write: if false;
    }
  }
}
