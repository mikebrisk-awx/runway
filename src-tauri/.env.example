# Google "Desktop app" OAuth client for the Runway macOS app.
# Created in GCP project runway-40912 (see BUILD-MACOS.md).
# These are read at COMPILE TIME by src-tauri/src/oauth.rs (option_env!),
# so they must be exported in the shell before `pnpm tauri:dev` / `pnpm tauri:build`.
RUNWAY_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
RUNWAY_GOOGLE_CLIENT_SECRET=your-desktop-client-secret
